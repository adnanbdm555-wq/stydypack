rules_version = '2';

// ============================================================================
// Study Pack (taleemihub.com) — Firebase Storage Security Rules
// Apply the same way as firestore.rules, but under:
// Firebase Console -> Build -> Storage -> "Rules" tab -> paste -> Publish
//
// Note: product images currently upload to ImgBB, not Firebase Storage, but
// Storage is initialized in the code, so it's locked down here too in case
// it's used later (e.g. for invoices, exports, or future image hosting).
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
  }
}
